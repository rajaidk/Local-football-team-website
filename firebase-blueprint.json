{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile representation stored under users/{userId}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth user ID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar image URL",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "MembershipApplication": {
      "title": "MembershipApplication",
      "description": "Club membership registration submitted by an authenticated user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Application document ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "ID of applicant user",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "description": "Email of applicant",
          "maxLength": 256
        },
        "fullName": {
          "type": "string",
          "description": "Full legal name",
          "maxLength": 100
        },
        "dob": {
          "type": "string",
          "description": "Date of birth in YYYY-MM-DD format",
          "maxLength": 20
        },
        "gender": {
          "type": "string",
          "description": "Selected gender",
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "description": "Contact email address",
          "maxLength": 256
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 30
        },
        "experience": {
          "type": "string",
          "description": "Football experience level",
          "maxLength": 50
        },
        "preferredPosition": {
          "type": "string",
          "description": "Preferred pitch position",
          "maxLength": 50
        },
        "trainingGoal": {
          "type": "string",
          "description": "Applicant training goal",
          "maxLength": 50
        },
        "medicalNotes": {
          "type": "string",
          "description": "Medical considerations or notes",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Application review status",
          "enum": ["pending", "reviewed", "accepted"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": ["userId", "fullName", "email", "phone", "status", "createdAt"]
    },
    "ContactEnquiry": {
      "title": "ContactEnquiry",
      "description": "Inquiry submitted through contact page",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Enquiry document ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "ID of sender user",
          "maxLength": 128
        },
        "purpose": {
          "type": "string",
          "description": "Enquiry purpose",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "description": "Contact name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Contact email",
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "description": "Message content",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": ["userId", "purpose", "name", "email", "message", "createdAt"]
    },
    "GameScore": {
      "title": "GameScore",
      "description": "Player game score record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Score record ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Player user ID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Player name",
          "maxLength": 100
        },
        "gameType": {
          "type": "string",
          "description": "Type of game: memory or guessing",
          "enum": ["memory", "guessing"],
          "maxLength": 30
        },
        "score": {
          "type": "number",
          "description": "Score points or completion metric"
        },
        "attempts": {
          "type": "number",
          "description": "Attempts taken"
        },
        "timeRemaining": {
          "type": "number",
          "description": "Seconds remaining on completion"
        },
        "createdAt": {
          "type": "string",
          "description": "Score timestamp"
        }
      },
      "required": ["userId", "displayName", "gameType", "score", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile and account details"
    },
    "/applications/{applicationId}": {
      "schema": "MembershipApplication",
      "description": "Stores football club registration applications"
    },
    "/enquiries/{enquiryId}": {
      "schema": "ContactEnquiry",
      "description": "Stores user contact and collaboration inquiries"
    },
    "/gameScores/{scoreId}": {
      "schema": "GameScore",
      "description": "Stores high scores and game history for players"
    }
  }
}
