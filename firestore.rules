rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Validation ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email']);
      allow delete: if false;
    }

    // --- Membership Applications Validation ---
    function isValidApplication(data) {
      return data.keys().hasAll(['userId', 'fullName', 'email', 'phone', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'userEmail', 'fullName', 'dob', 'gender', 'email', 'phone', 'experience', 'preferredPosition', 'trainingGoal', 'medicalNotes', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             data.status in ['pending', 'reviewed', 'accepted'] &&
             (!('dob' in data) || (data.dob is string && data.dob.size() <= 20)) &&
             (!('gender' in data) || (data.gender is string && data.gender.size() <= 20)) &&
             (!('experience' in data) || (data.experience is string && data.experience.size() <= 50)) &&
             (!('preferredPosition' in data) || (data.preferredPosition is string && data.preferredPosition.size() <= 50)) &&
             (!('trainingGoal' in data) || (data.trainingGoal is string && data.trainingGoal.size() <= 50)) &&
             (!('medicalNotes' in data) || (data.medicalNotes is string && data.medicalNotes.size() <= 1000)) &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /applications/{applicationId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(applicationId) && isValidApplication(incoming()) && incoming().status == 'pending';
      allow update: if isSignedIn() && isValidId(applicationId) && resource.data.userId == request.auth.uid &&
                    isValidApplication(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().status == existing().status &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'dob', 'gender', 'email', 'phone', 'experience', 'preferredPosition', 'trainingGoal', 'medicalNotes']);
      allow delete: if isSignedIn() && isValidId(applicationId) && resource.data.userId == request.auth.uid;
    }

    // --- Contact Enquiries Validation ---
    function isValidEnquiry(data) {
      return data.keys().hasAll(['userId', 'purpose', 'name', 'email', 'message', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'purpose', 'name', 'email', 'message', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.purpose is string && data.purpose.size() > 0 && data.purpose.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /enquiries/{enquiryId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(enquiryId) && isValidEnquiry(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(enquiryId) && resource.data.userId == request.auth.uid;
    }

    // --- Game Scores Validation ---
    function isValidGameScore(data) {
      return data.keys().hasAll(['userId', 'displayName', 'gameType', 'score', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'displayName', 'gameType', 'score', 'attempts', 'timeRemaining', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.gameType in ['memory', 'guessing'] &&
             data.score is number &&
             (!('attempts' in data) || data.attempts is number) &&
             (!('timeRemaining' in data) || data.timeRemaining is number) &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /gameScores/{scoreId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scoreId) && isValidGameScore(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(scoreId) && resource.data.userId == request.auth.uid;
    }
  }
}
